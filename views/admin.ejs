<% layout('layouts/boilerplate') %>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <p class="page-kicker mb-2">Administration</p>
        <h1 class="fw-bold mb-1">Event Dashboard</h1>
        <p class="text-muted mb-0">Manage events and review registrations.</p>
    </div>
    <a href="/events/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        New Event
    </a>
</div>

<div class="row g-4">
    <% for(let event of events){ %>
    <div class="col-md-6 col-xl-4">
        <article class="event-card h-100 d-flex flex-column">
        <img src="<%= event.thumbnail %>" alt="<%= event.title %>">
        <div class="p-4 d-flex flex-column flex-grow-1">
            <h2 class="h4 fw-bold"><%= event.title %></h2>
            <p class="text-muted flex-grow-1"><%= event.description %></p>
            <div class="small mb-3">
                <div class="mb-2">
                <i class="bi bi-geo-alt text-primary me-2"></i>
                    <%= event.venue %>
                
            </div>
            <div>
                <i class="bi bi-calendar3 text-primary me-2"></i>
                <%= event.date.toLocaleDateString('en-IN') %> at <%= event.time %>
                
            </div>
            </div>
            <div class="d-grid gap-2">
                <a class="btn btn-primary" href="/events/<%= event._id %>/registrations">
                    <i class="bi bi-people me-1"></i>
                    See Registrations
                </a>
                <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary flex-grow-1" href="/events/<%= event._id %>/edit">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>
                <form class="flex-grow-1" action="/events/<%= event._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-outline-danger w-100">
                        <i class="bi bi-trash me-1"></i>
                        Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</article>
</div>
<% } %>
</div>
