<% layout('layouts/boilerplate') %>
<div class="mx-auto" style="max-width:850px">
    <div class="mb-4">
<p class="page-kicker mb-2">Admin workspace</p>
<h1 class="fw-bold mb-1">Create New Event</h1>
    <p class="text-muted">Add the event information students need to register.</p>
</div>
<div class="surface-card p-4 p-lg-5">
    <form action="/events" method="POST">
<div class="row g-4"><div class="col-md-6">
<label class="form-label fw-semibold" for="title">Event title</label>
<input class="form-control" type="text" id="title" name="event[title]" placeholder="e.g. AI Workshop">
</div>
<div class="col-md-6">
<label class="form-label fw-semibold" for="venue">Venue</label>
<input class="form-control" type="text" id="venue" name="event[venue]" placeholder="Building and room">
</div>
<div class="col-12">
<label class="form-label fw-semibold" for="thumbnail">Thumbnail URL</label>
<input class="form-control" type="text" id="thumbnail" name="event[thumbnail]" placeholder="https://...">
</div>
<div class="col-12">
    <label class="form-label fw-semibold" for="description">Description</label>
<textarea class="form-control" id="description" name="event[description]" placeholder="Describe the event">

</textarea>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="date">Date</label>
<input class="form-control" type="date" id="date" name="event[date]" required>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="time">Time</label>
<input class="form-control" type="time" id="time" name="event[time]">
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="capacity">Capacity</label>
<input class="form-control" type="number" id="capacity" name="event[capacity]" placeholder="Number of seats">
</div>
</div>
<div class="d-flex flex-wrap gap-2 mt-4">
    <button class="btn btn-primary px-4">
    <i class="bi bi-plus-lg me-1"></i>Add Event
</button>
<a class="btn btn-outline-secondary px-4" href="/events">Cancel</a>
</div>
</form>
</div>
</div>
