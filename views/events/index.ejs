<% layout('layouts/boilerplate') %>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
<p class="page-kicker mb-2">Explore campus</p>
<h1 class="fw-bold mb-2">Upcoming Events</h1>
<p class="text-muted mb-0">Find workshops, competitions and activities made for you.</p>
</div>
<span class="badge rounded-pill text-bg-light border px-3 py-2"><%= events.length %> events</span>
</div>
<div class="row g-4">
<% for(let event of events){ %>
<div class="col-md-6 col-lg-4">
<article class="event-card h-100 d-flex flex-column">
<img src="<%= event.thumbnail %>" alt="<%= event.title %>">
<div class="p-4 d-flex flex-column flex-grow-1">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="meta-chip"><i class="bi bi-calendar3">

        </i><%= event.date.toLocaleDateString('en-IN') %></span>
        <span class="meta-chip"><i class="bi bi-clock">
        </i><%= event.time %>
    </span>
    </div>
<h2 class="h4 fw-bold"><%= event.title %></h2>
<p class="text-muted flex-grow-1"><%= event.description %>
</p>
<p class="small mb-4">
<i class="bi bi-geo-alt text-primary me-1"></i><%= event.venue %> &nbsp; 
<i class="bi bi-people text-primary ms-2 me-1"></i><%= event.capacity %> seats
</p>
<a class="btn btn-primary w-100" href="/events/<%= event._id %>">View Event 
    <i class="bi bi-arrow-right ms-1">

    </i>
</a>
</div>
</article>
</div><% } %>
</div>
