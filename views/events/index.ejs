<% layout('layouts/boilerplate')%>

<h1>All Events</h1>

<% for (let event of events){%>
<div class="card mb-3">
    <div class="row">
        <div class="col-md-4">
            <img class="img-fluid" alt="" src="<%=event.thumbnail%>">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title"><%= event.title %> </h5>
                <p class="card-text"><%= event.description %></p>
                <p class="card-text">
                    <small class="text-muted"><%= event.venue%></small>
                </p>
                <p class="card-text">
                Date: <%= event.date.toLocaleDateString("en-IN") %>
                </p>
                <p class="card-text">Time: <%= event.time %></p>
                <p class="card-text">Capacity: <%= event.capacity %></p>

                <a class="btn btn-primary" href="/events/<%=event._id%>">View <%=event.title%></a>
            </div>
        </div>
    </div>
</div>
<% }%>