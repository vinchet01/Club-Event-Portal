<% layout('layouts/boilerplate')%>
<div class="row">
    <h1 class="text-center">Edit Event</h1>
    <div class="col-6 offset-3">
        <form action="/events/<%=event._id%>?_method=PUT" method="POST">

            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input class="form-control" type="text" id="title" name="event[title]"
                    value="<%=event.title %>">
            </div>

            <div class="mb-3">
                <label class="form-label" for="venue">Venue</label>
                <input class="form-control" type="text" id="venue" name="event[venue]"
                    value="<%=event.venue %>">
            </div>


            <div class="mb-3">
                <label class="form-label" for="thumbnail">Thumbnail Url</label>
                <input class="form-control" type="text" id="thumbnail" name="event[thumbnail]"
                    value="<%=event.thumbnail %>">
            </div>

            <div class="mb-3">
                <label class="form-label" for="description">Description</label>
                <textarea class="form-control" type="text" id="description"
                    name="event[description]"><%= event.description%></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="date">Date</label>
                <input
                    class="form-control"
                    type="date"
                    id="date"
                    name="event[date]"
                    value="<%= event.date.toISOString().split('T')[0] %>"
                >
            </div>

            <div class="mb-3">
                <label class="form-label" for="time">Time</label>
                <input class="form-control" type="time" id="time" name="event[time]"
                    value="<%=event.time %>">
            </div>

            <div class="mb-3">
                <label class="form-label" for="capacity">Capacity</label>
                <input class="form-control" type="number" id="capacity" name="event[capacity]"
                    value="<%=event.capacity %>">
            </div>

            




            <div class="mb-3">
                <button class="btn btn-info">Update Event</button>
            </div>
        </form>
        
        <a href="/admin">Back To Admin</a>

    </div>
</div>