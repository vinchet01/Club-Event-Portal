<% layout('layouts/boilerplate') %>
<div class="mx-auto" style="max-width:850px">
<div class="mb-4">
<p class="page-kicker mb-2">Admin workspace</p>
<h1 class="fw-bold mb-1">Edit Event</h1>
<p class="text-muted">
Update the details for 
<%= event.title %>.
</p>
</div>
<div class="surface-card p-4 p-lg-5">
<form action="/events/<%= event._id %>?_method=PUT" method="POST">
<div class="row g-4"><div class="col-md-6">
<label class="form-label fw-semibold" for="title">
Event title
</label>
<input class="form-control" type="text" id="title" name="event[title]" value="<%= event.title %>">
</div>
<div class="col-md-6">
<label class="form-label fw-semibold" for="venue">Venue</label>
<input class="form-control" type="text" id="venue" name="event[venue]" value="<%= event.venue %>">
</div>
<div class="col-12">
    <label class="form-label fw-semibold" for="thumbnail">Thumbnail URL</label>
<input class="form-control" type="text" id="thumbnail" name="event[thumbnail]" value="<%= event.thumbnail %>">
</div>
<div class="col-12">
<label class="form-label fw-semibold" for="description">Description</label>
<textarea class="form-control" id="description" name="event[description]"><%= event.description %>
</textarea>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="date">Date</label>
<input class="form-control" type="date" id="date" name="event[date]" value="<%= event.date.toISOString().split('T')[0] %>">
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="time">Time</label>
<input class="form-control" type="time" id="time" name="event[time]" value="<%= event.time %>">
</div>
<div class="col-md-4">
<label class="form-label fw-semibold" for="capacity">Capacity</label>
<input class="form-control" type="number" id="capacity" name="event[capacity]" value="<%= event.capacity %>">
</div>
</div>
<div class="d-flex flex-wrap gap-2 mt-4">
<button class="btn btn-primary px-4">
<i class="bi bi-check2 me-1"></i>
Update Event
</button>
<a class="btn btn-outline-secondary px-4" href="/admin">Cancel</a>
</div>
</form>
</div>
</div>
