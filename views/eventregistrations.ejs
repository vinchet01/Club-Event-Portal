<% layout('layouts/boilerplate') %>
<div class="mb-4">
    <a href="/admin" class="text-decoration-none">
    <i class="bi bi-arrow-left me-1"></i>
    Back to admin
</a>
</div>
<div class="surface-card overflow-hidden">
    <div class="row g-0">
        <div class="col-lg-4">
<img src="<%= event.thumbnail %>" class="w-100 h-100" style="min-height:280px;object-fit:cover" alt="<%= event.title %>">
</div>
<div class="col-lg-8 p-4 p-lg-5">
    <p class="page-kicker mb-2">Registration report</p>
    <h1 class="fw-bold"><%= event.title %></h1>
    <p class="text-muted"><%= event.description %></p>
    <div class="d-flex flex-wrap gap-2">
        <span class="meta-chip">
    <i class="bi bi-geo-alt"></i>
    <%= event.venue %>
</span>
<span class="meta-chip">
    <i class="bi bi-calendar3"></i>
    <%= event.date.toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %>
</span>
<span class="meta-chip">
    <i class="bi bi-clock"></i>
    <%= event.time %>
</span>
</div>
</div>
</div>
<div class="p-4 p-lg-5 border-top">
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-card">
        <div class="text-muted small">Registrations</div>
        <div class="h3 fw-bold mb-0">
        <%= event.registrations.length %>
        </div>
    </div>
</div>
<div class="col-sm-4">
    <div class="stat-card">
    <div class="text-muted small">Capacity

    </div>
    <div class="h3 fw-bold mb-0">
        <%= event.capacity %>
    </div>
</div>
</div>
<div class="col-sm-4">
<div class="stat-card">
<div class="text-muted small">
    Remaining
</div>
<div class="h3 fw-bold mb-0">
<%= event.capacity-event.registrations.length %>
</div>
</div>
</div>
</div>
<% if(event.registrations.length===0){ %>
    <div class="text-center py-5">
    <i class="bi bi-people display-5 text-muted"></i>
    <p class="text-muted mt-3 mb-0">No registrations yet.</p>
</div>
<% } else { %>
    <div class="table-responsive">
        <table class="table table-modern align-middle">
            <thead>
            <tr>
            <th>#</th>
        <th>Participant</th>
        <th>Email</th>
    </tr>
</thead>
<tbody>
<% for(let participant of event.registrations){ %>
    <tr>
<td class="text-muted">
<%= event.registrations.indexOf(participant)+1 %>
</td>
<td class="fw-semibold">
    <%= participant.username %></td><td><%= participant.email %>
    </td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
</div>
</div>
