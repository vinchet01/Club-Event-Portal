<% layout('layouts/boilerplate')%>

<div class="row">
    <div class="col-6 offset-3">
        <div class="card mb-3">
            <img src="<%= event.thumbnail%>" class="card-img-top">
            <div class="card-body">
                <h5 class="card-title"><%= event.title%></h5>
                <p class="card-text"><%= event.description%></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item text-muted">Venue: <%= event.venue%></li>
                <li class="list-group-item text-muted">Date: <%= event.date.toLocaleDateString("en-IN", {
                day: "numeric",
                month: "long",
                year: "numeric"
                }) %></li>
                <li class="list-group-item text-muted">Time: <%= event.time%></li>
                <li class="list-group-item text-muted">Capacity: <%= event.capacity%></li>
            </ul>
<div class="card-footer text-muted">
                <p class="list-group-item text-muted">Posted at: <%= event.createdAt.toLocaleString("en-IN", {
                dateStyle: "medium",
                timeStyle: "short"
                }) %></p>
            </div>
<h4 class="mt-3">
    Registrations: <%= event.registrations.length %>
</h4>

<% if (event.registrations.length === 0) { %>
    <p class="text-muted">No registrations yet.</p>
<% } else { %>
    <p>
    Remaining seats:
    <%= event.capacity - event.registrations.length %>
</p>
    <ul class="list-group">
        <% for (let participant of event.registrations) { %>
            <li class="list-group-item">
                <strong><%= participant.username %></strong>
                <br>
                <%= participant.email %>
            </li>
        <% } %>
    </ul>
    
<% } %>


            
        </div>
    </div>
</div>
