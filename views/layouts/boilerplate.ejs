<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>CODEAI Pulse</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
:root{--pulse:#6366f1;--purple:#8b5cf6;--ink:#172033;--muted:#64748b}body{min-height:100vh;background:#f4f7fb;color:var(--ink)}main{flex:1}.page-wrap{padding-top:3rem;padding-bottom:4rem}.page-kicker{color:var(--pulse);font-size:.78rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.surface-card{border:1px solid #e7eaf1;border-radius:1.25rem;background:#fff;box-shadow:0 10px 35px rgba(23,32,51,.07)}.event-card{overflow:hidden;border:1px solid #e7eaf1;border-radius:1.2rem;background:#fff;box-shadow:0 8px 28px rgba(23,32,51,.06);transition:.2s}.event-card:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(23,32,51,.11)}.event-card img{width:100%;height:220px;object-fit:cover}.event-cover{width:100%;max-height:430px;object-fit:cover}.meta-chip{display:inline-flex;align-items:center;gap:.45rem;padding:.45rem .7rem;border-radius:.7rem;background:#f1f3ff;color:#4f46e5;font-size:.9rem;font-weight:600}.btn{border-radius:.7rem;font-weight:600}.btn-primary{border-color:var(--pulse);background:var(--pulse)}.btn-primary:hover{border-color:#5154d9;background:#5154d9}.form-control{min-height:48px;border-radius:.7rem;border-color:#dce1ea}textarea.form-control{min-height:120px}.form-control:focus{border-color:var(--pulse);box-shadow:0 0 0 .22rem rgba(99,102,241,.13)}.flash-layer{width:min(92%,700px);z-index:1080}.table-modern{--bs-table-bg:transparent}.table-modern th{color:var(--muted);font-size:.78rem;letter-spacing:.06em;text-transform:uppercase}.stat-card{padding:1.3rem;border:1px solid #e7eaf1;border-radius:1rem;background:#fff}
</style></head><body class="d-flex flex-column"><%- include('../partials/navbar') %><main><div class="position-fixed top-0 start-50 translate-middle-x mt-3 flash-layer"><%- include('../partials/flash') %></div><div class="container page-wrap"><%- body %></div></main><%- include('../partials/footer') %><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
